{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Cloudflare Workers project name. OpenNext derives the
  // WORKER_SELF_REFERENCE service binding from this value, so if it disagrees
  // with the deployed script name the deploy fails with error 10143.
  "name": "josedev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "josedev"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
