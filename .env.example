# Blog content source. Unset (the default) means posts come from the committed
# content in src/content/posts.ts. Set PAYLOAD_URL to read them from the
# multi-tenant Payload instance instead — see src/lib/posts.ts.
#
#   PAYLOAD_URL=https://<the payload deployment>
#   PAYLOAD_TENANT_SLUG=joseviews        # optional, defaults to joseviews
#
# Posts are cached under the tags `posts` and `post:<slug>`. The CMS clears
# them by POSTing to /api/revalidate when an editor publishes — that route
# needs the same shared secret the CMS sends in x-revalidate-secret:
#
#   REVALIDATE_SECRET=...                # wrangler secret, not a var
#
# Set the CMS end to match: SITE_REVALIDATE_URL and REVALIDATE_SECRET there.
# Without an incremental cache configured in open-next.config.ts the tags are
# inert on Workers, so this is not wired up in production yet.

# Contact form delivery runs through Cloudflare Email Routing — no third-party
# provider and no env vars in this file.
#
#   wrangler.jsonc  →  CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL vars
#                      and the CONTACT_EMAIL send_email binding
#   wrangler secret →  CONTACT_INTERNAL_KEY (gates the internal send route)
#
# See custom-worker.js and the README "Contact form" section. Without the
# Workers runtime (plain `next dev`) submissions are validated and logged
# server-side but NOT emailed.
